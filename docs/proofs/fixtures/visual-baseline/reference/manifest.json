{
  "version": 2,
  "packagedResource": {
    "uri": "ui://gitright/repository-state-v2.html",
    "mimeType": "text/html;profile=mcp-app"
  },
  "captureInputs": {
    "browser": {
      "engine": "chromium",
      "version": "149.0.7827.55"
    },
    "viewportHeightPx": 900,
    "widths": {
      "narrow": 380,
      "wide": 720
    },
    "themes": [
      "light",
      "dark"
    ],
    "locales": {
      "en": "en-US",
      "ja": "ja-JP"
    },
    "deviceScaleFactor": 1,
    "reducedMotion": "reduce",
    "safeAreaInsets": {
      "top": 0,
      "right": 0,
      "bottom": 0,
      "left": 0
    },
    "timezone": "UTC",
    "hostSurfaceBackgroundColor": {
      "published": false,
      "fallback": {
        "light": "#f2f3f7",
        "dark": "#1c1c1e"
      }
    },
    "historySnapshotTime": 1767225605,
    "browserNetworkPolicy": "block-and-record-http-and-https",
    "serverEnvironment": {
      "TZ": "UTC",
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8"
    },
    "fixtureRepositoryPath": "/private/tmp/gitright-visual-fixture"
  },
  "captures": [
    {
      "file": "history-narrow-dark-ja.png",
      "surface": "history",
      "widthPx": 380,
      "theme": "dark",
      "locale": "ja",
      "displayMode": "fullscreen"
    },
    {
      "file": "diff-narrow-light-en.png",
      "surface": "diff",
      "widthPx": 380,
      "theme": "light",
      "locale": "en",
      "displayMode": "fullscreen"
    },
    {
      "file": "search-wide-light-ja.png",
      "surface": "search",
      "widthPx": 720,
      "theme": "light",
      "locale": "ja",
      "displayMode": "fullscreen"
    },
    {
      "file": "unavailable-wide-dark-en.png",
      "surface": "unavailable",
      "widthPx": 720,
      "theme": "dark",
      "locale": "en",
      "displayMode": "fullscreen"
    },
    {
      "file": "launcher-narrow-dark-en.png",
      "surface": "launcher",
      "widthPx": 380,
      "theme": "dark",
      "locale": "en",
      "displayMode": "inline"
    }
  ]
}
